-- Juice Zoo: every module of playdate-juice, one exhibit each.
--
-- The hub is itself built from the library: an animated background behind
-- the menu, a spring on the selection bar, a transition on every hop, the
-- menu theme and the blips from chiptune. Built by tools/build_demo.py.
import "CoreLibs/graphics"
import "transitions"
import "backgrounds"
import "tween"
import "shake"
import "particles"
import "jukebox"
import "chiptune"
import "credits"

local gfx <const> = playdate.graphics
local W <const> = 400
local H <const> = 240
local floor <const> = math.floor
local max <const> = math.max
local min <const> = math.min
local sin <const> = math.sin
local abs <const> = math.abs

playdate.display.setRefreshRate(30)

local fontBold = gfx.font.new("fonts/Roobert-10-Bold")
local fontTitle = gfx.font.new("fonts/Roobert-11-Medium")
local fontMono = gfx.font.new("fonts/Roobert-11-Mono-Condensed")
assert(fontBold and fontTitle and fontMono)

-- ─── audio ─────────────────────────────────────────────────────────────────

-- Each song shows a style and a set of chiptune techniques (GB: the four
-- Game Boy channels exactly; v2: the extended format's voices).
local SONGS = {
    { id = "cloud_garden",  title = "Cloud Garden",  style = "Menu - PWM pad, filter, echo", tag = "v2 6ch" },
    { id = "tidal_twang",   title = "Tidal Twang",   style = "Surf - retrig tremolo, P-kick", tag = "GB" },
    { id = "jungle_pulse",  title = "Jungle Pulse",  style = "DnB - sampled break, reese", tag = "v2 8ch" },
    { id = "crimson_clash", title = "Crimson Clash", style = "Battle - sync lead, SID drums", tag = "v2 7ch" },
    { id = "willow_lane",   title = "Willow Lane",   style = "Waltz - duty sweep, 3/4", tag = "GB" },
    { id = "hollow_deep",   title = "Hollow Deep",   style = "Dungeon - ring mod bell, BP", tag = "v2 7ch" },
    { id = "neon_acid",     title = "Neon Acid",     style = "Acid - 303 squelch, 808 kit", tag = "v2 6ch" },
    { id = "victory",       title = "Victory",       style = "Fanfare - ends", tag = "v2 5ch" },
    { id = "fade_out",      title = "Fade Out",      style = "Game over - ends", tag = "GB" },
    { id = "steel_circuit", title = "Steel Circuit", style = "Rock - PCM8 band, acid break", tag = "PCM 8ch", bank = "rock" },
    { id = "chrome_breaks", title = "Chrome Breaks", style = "Jungle - chopped drums, reese", tag = "PCM 8ch", bank = "rock" },
    { id = "prism_drive",   title = "Prism Drive",   style = "Trance - supersaw, offbeat bass", tag = "PCM 8ch", bank = "rock" },
    { id = "studio_menu",  title = "Studio Menu",  style = "Original rock arrangement - 140 BPM", tag = "PCM A/B", bank = "studio", reference = true },
    { id = "studio_play",  title = "Studio Play",  style = "Original table theme - 132 BPM", tag = "PCM A/B", bank = "studio", reference = true },
    { id = "studio_multi", title = "Studio Multi", style = "Original multiball theme - 166 BPM", tag = "PCM A/B", bank = "studio", reference = true },
    { id = "jungle_ride",   title = "Jungle Ride",   style = "Jungle - chopped break, reese, pads", tag = "FT2 7ch" },
    { id = "jungle_race",   title = "Jungle Race",   style = "Jungle - hard break, hoover, rolls", tag = "FT2 7ch" },
    { id = "jungle_menu",   title = "Jungle Menu",   style = "Jungle - calm, flute, rolling bass", tag = "FT2 6ch" },
}
local songPaths = {}
for _, s in ipairs(SONGS) do
    local path = "music/" .. s.id .. ".gbm"
    songPaths[s.id] = s.bank and { path = path, bank = s.bank } or path
end
local chipOk, chipErr = Chiptune.load({ songs = songPaths, sfx = "music/sfx.gbm",
                                        banks = { rock = "music/rock.gbank", studio = "music/overturn.gbank" },
                                        duck = { amount = 6, speed = 2 }, volume = 0.8 })
if not chipOk then print(chipErr) end

-- Pre-rendered by build_demo.py (tools/chiptune.py render): the same music
-- as files, for the Jukebox exhibit and for games without the C extension.
local streamPaths, streamVolumes = {}, {}
for _, s in ipairs(SONGS) do
    streamPaths[s.id], streamVolumes[s.id] = "jukebox/" .. s.id, 0.8
end
Jukebox.load({ tracks = streamPaths, volumes = streamVolumes })

-- A named chiptune effect (silent without the extension).
local function blip(name) Chiptune.sfx(name) end

-- Transitions.start looks for a TransitionSounds global and calls play(name,
-- dir) as a wipe begins: here each transition's whoosh from the SFX bank.
TransitionSounds = { enabled = false }
function TransitionSounds.play(name, dir)
    if not TransitionSounds.enabled then return false end
    return Chiptune.sfx("tr_" .. name:lower():gsub(" ", "_") .. "_" .. dir)
end

function playdate.gameWillPause() Chiptune.pause(); Jukebox.pause() end
function playdate.gameWillResume() Chiptune.resume(); Jukebox.resume() end

-- ─── drawing helpers ───────────────────────────────────────────────────────

local tick = 0

-- Playdate text markup: _ toggles italic and * bold. Names like
-- "double_jump" come from data, so they are shown with spaces.
local function plain(name) return (name:gsub("_", " ")) end

local function outlined(text, x, y)
    gfx.setImageDrawMode(gfx.kDrawModeFillWhite)
    for dx = -1, 1 do
        for dy = -1, 1 do
            if dx ~= 0 or dy ~= 0 then gfx.drawText(text, x + dx, y + dy) end
        end
    end
    gfx.setImageDrawMode(gfx.kDrawModeCopy)
    gfx.drawText(text, x, y)
end

local function panel(x, y, w, h)
    gfx.setColor(gfx.kColorWhite)
    gfx.fillRect(x, y, w, h)
    gfx.setColor(gfx.kColorBlack)
    gfx.setLineWidth(2)
    gfx.drawRect(x, y, w, h)
    gfx.drawRect(x + 3, y + 3, w - 6, h - 6)
    gfx.setLineWidth(1)
end

local function header(text, sub)
    gfx.setColor(gfx.kColorBlack)
    gfx.fillRect(0, 0, W, 22)
    gfx.setFont(fontTitle)
    gfx.setImageDrawMode(gfx.kDrawModeFillWhite)
    gfx.drawText(text, 8, 3)
    if sub then
        gfx.setFont(fontBold)
        local w = gfx.getTextSize(sub)
        gfx.drawText(sub, W - w - 8, 5)
    end
    gfx.setImageDrawMode(gfx.kDrawModeCopy)
end

local function footer(text)
    gfx.setColor(gfx.kColorWhite)
    gfx.fillRect(0, H - 18, W, 18)
    gfx.setColor(gfx.kColorBlack)
    gfx.drawLine(0, H - 18, W, H - 18)
    gfx.setFont(fontBold)
    gfx.drawText(text, 8, H - 15)
end

-- A selectable list with a sliding bar; `spring` (frames) smooths the bar's y.
local function list(items, sel, x, y, w, rowH, visible, spring, label)
    local first = max(1, min(sel - floor(visible / 2), #items - visible + 1))
    local target = y + (sel - first) * rowH
    local by = floor(spring:update(target) + 0.5)
    gfx.setColor(gfx.kColorBlack)
    gfx.fillRect(x, by - 1, w, rowH)
    gfx.setFont(fontBold)
    for i = first, min(#items, first + visible - 1) do
        local iy = y + (i - first) * rowH
        local text = label and label(items[i], i) or tostring(items[i])
        if i == sel then gfx.setImageDrawMode(gfx.kDrawModeFillWhite) end
        gfx.drawText(text, x + 6, iy)
        gfx.setImageDrawMode(gfx.kDrawModeCopy)
    end
    return first
end

-- Four channel meters: the chiptune APU as it sounds right now.
local meterPeak = { 0, 0, 0, 0, 0, 0, 0, 0 }
-- Draws one meter per channel into `width` pixels: four for a Game Boy
-- song, up to eight for a format-2 one. Returns how many there were.
local function meters(x, y, h, cursor, muted, width)
    local lv = { Chiptune.levels() }
    local n = max(4, #lv)
    local step = floor((width or 120) / n)
    local bw = min(22, step - 2)
    local names = n == 4 and step >= 30 and { "PU1", "PU2", "WAV", "NOI" } or nil
    gfx.setFont(fontBold)
    for c = 1, n do
        local v = lv[c] or 0
        meterPeak[c] = max(v, meterPeak[c] - 0.5)
        local bx = x + (c - 1) * step
        gfx.setColor(gfx.kColorBlack)
        gfx.drawRect(bx, y, bw, h)
        local fill = floor((h - 4) * v / 15)
        gfx.fillRect(bx + 2, y + h - 2 - fill, bw - 4, fill)
        local py = y + h - 2 - floor((h - 4) * meterPeak[c] / 15)
        gfx.drawLine(bx + 2, py, bx + bw - 3, py)
        if muted and muted[c] then
            gfx.drawLine(bx, y, bx + bw, y + h)
            gfx.drawLine(bx + bw, y, bx, y + h)
        end
        if cursor == c then gfx.fillRect(bx, y + h + 16, bw, 2) end
        gfx.drawText(names and names[c] or tostring(c), bx, y + h + 3)
    end
    return n
end

-- ─── scenes ────────────────────────────────────────────────────────────────

local scenes = {}
local current = "hub"

local function go(id, effect, dir)
    if Transitions.active then return end
    local leaving = scenes[current]
    if leaving.leave then leaving.leave() end
    -- The snapshot is taken now: the screen still shows the outgoing scene.
    TransitionSounds.enabled = false
    Transitions.start(effect or "Fade", dir or "fwd", 18)
    current = id
    if scenes[id].enter then scenes[id].enter() end
end

local pressed = playdate.buttonJustPressed
local held = playdate.buttonIsPressed
local UP, DOWN, LEFT, RIGHT = playdate.kButtonUp, playdate.kButtonDown, playdate.kButtonLeft, playdate.kButtonRight
local A, B = playdate.kButtonA, playdate.kButtonB

-- Held arrows repeat: a press, then after a third of a second one step every
-- 3 frames. `stepped` is what every exhibit reads for the d-pad.
local heldFrames = { [UP] = 0, [DOWN] = 0, [LEFT] = 0, [RIGHT] = 0 }
local function trackHeld()
    for b in pairs(heldFrames) do heldFrames[b] = held(b) and heldFrames[b] + 1 or 0 end
end
local function stepped(b)
    local h = heldFrames[b]
    return pressed(b) or (h > 10 and h % 3 == 0)
end

-- Up/down through a list of n, wrapping at both ends.
local function navigate(sel, n)
    local d = stepped(UP) and -1 or (stepped(DOWN) and 1 or 0)
    if d ~= 0 then
        blip("cursor")
        return (sel - 1 + d) % n + 1
    end
    return sel
end

-- ─── the hub ───────────────────────────────────────────────────────────────

local EXHIBITS = {
    { id = "transitions", name = "Transitions",       blurb = "23 scene transitions and a hop plan", fx = "Circle" },
    { id = "backgrounds", name = "Backgrounds",       blurb = "17 looping procedural backgrounds",   fx = "Dissolve" },
    { id = "tween",       name = "Tween",             blurb = "31 easings, springs, sequences",      fx = "Slide" },
    { id = "impact",      name = "Shake & Particles", blurb = "Trauma shake, pooled 1-bit particles", fx = "Shatter" },
    { id = "music",       name = "Chiptune: Music",   blurb = "18 songs: Game Boy, SID and PCM band", fx = "Scanline" },
    { id = "sfx",         name = "Chiptune: SFX",     blurb = "84 effects that duck the music",      fx = "Pixel Shift" },
    { id = "jukebox",     name = "Jukebox",           blurb = "Three sounds: live tracker or stream", fx = "Fade" },
    { id = "credits",     name = "Credits",           blurb = "Rolls and cards; the crank scrubs",   fx = "Blink" },
}
local hubSel = 1
local hubSpring = Tween.newSpring(0, 3)
local hubBg = Backgrounds.indexOf("Plasma") or 1

scenes.hub = {
    enter = function() Chiptune.play("cloud_garden") end,
    input = function()
        hubSel = navigate(hubSel, #EXHIBITS)
        if pressed(A) then
            blip("select")
            local e = EXHIBITS[hubSel]
            go(e.id, e.fx, "fwd")
        end
    end,
    update = function() Backgrounds.update(hubBg) end,
    draw = function()
        Backgrounds.draw(hubBg)
        local px, py, pw, ph = 70, 18, 260, 196
        panel(px, py, pw, ph)
        gfx.setFont(fontTitle)
        local t = "JUICE ZOO"
        local tw = gfx.getTextSize(t)
        gfx.drawText(t, px + (pw - tw) / 2, py + 9)
        gfx.drawLine(px + 12, py + 30, px + pw - 12, py + 30)
        list(EXHIBITS, hubSel, px + 10, py + 38, pw - 20, 17, 8, hubSpring, function(e) return e.name end)
        gfx.setFont(fontBold)
        outlined(EXHIBITS[hubSel].blurb, 12, H - 18)
        if chipOk and Chiptune.current() then
            local s = "~ " .. plain(Chiptune.current())
            local sw = gfx.getTextSize(s)
            outlined(s, W - sw - 10, 4)
        end
    end,
}

-- ─── transitions ───────────────────────────────────────────────────────────

do
    local TRANS = Transitions.names
    local sel, speed, mode, bg = 1, 24, "list", 1
    local spring = Tween.newSpring(0, 3)
    local auto, autoPause = false, 0

    local function play(dir)
        TransitionSounds.enabled = true
        Transitions.start(TRANS[sel], dir, floor(speed))
    end

    scenes.transitions = {
        enter = function() mode = "list" end,
        input = function()
            if auto then
                if autoPause > 0 then autoPause = autoPause - 1; return end
                if mode == "list" then
                    bg = bg % Backgrounds.count + 1
                    mode = "card"; play("fwd"); autoPause = 25
                else
                    mode = "list"; play("back"); autoPause = 15
                    sel = sel + 1
                    if sel > #TRANS then sel, auto = 1, false end
                end
                return
            end
            local cc = playdate.getCrankChange()
            if abs(cc) > 1 then speed = max(8, min(60, speed + cc * 0.12)) end
            if mode == "list" then
                sel = navigate(sel, #TRANS)
                if pressed(A) then bg = bg % Backgrounds.count + 1; mode = "card"; play("fwd") end
                if pressed(B) then go("hub", "Circle", "back") end
            else
                if pressed(A) then bg = bg % Backgrounds.count + 1; play("fwd") end
                if pressed(B) then mode = "list"; play("back") end
                if stepped(LEFT) then bg = (bg - 2) % Backgrounds.count + 1 end
                if stepped(RIGHT) then bg = bg % Backgrounds.count + 1 end
            end
        end,
        update = function() if mode == "card" then Backgrounds.update(bg) end end,
        draw = function()
            if mode == "list" then
                gfx.clear(gfx.kColorWhite)
                header("Transitions", "speed " .. floor(speed) .. "f  (crank)")
                list(TRANS, sel, 10, 30, 180, 15, 12, spring)
                gfx.setFont(fontBold)
                gfx.drawTextInRect(Transitions.descriptions[TRANS[sel]] or "", 205, 34, 185, 150)
                footer("A play   B back   crank: speed   menu: auto showcase")
            else
                Backgrounds.draw(bg)
                local cw, ch = 220, 54
                local cx, cy = (W - cw) / 2, (H - ch) / 2 - 10
                gfx.setColor(gfx.kColorWhite)
                gfx.fillRoundRect(cx, cy, cw, ch, 4)
                gfx.setColor(gfx.kColorBlack)
                gfx.setLineWidth(2)
                gfx.drawRoundRect(cx, cy, cw, ch, 4)
                gfx.setLineWidth(1)
                gfx.setFont(fontTitle)
                local n = TRANS[sel]
                local nw = gfx.getTextSize(n)
                gfx.drawText(n, cx + (cw - nw) / 2, cy + 8)
                gfx.setFont(fontBold)
                local b = "BG: " .. Backgrounds.getName(bg)
                local bw = gfx.getTextSize(b)
                gfx.drawText(b, cx + (cw - bw) / 2, cy + 32)
                outlined("A next   B list   left/right: background", 12, H - 16)
            end
        end,
    }

    playdate.getSystemMenu():addMenuItem("Auto Showcase", function()
        if current ~= "transitions" then go("transitions", "Circle", "fwd") end
        auto, autoPause, mode = true, 10, "list"
    end)
end

-- ─── backgrounds ───────────────────────────────────────────────────────────

do
    local bg = 1
    local seed = 1
    scenes.backgrounds = {
        input = function()
            if stepped(RIGHT) or stepped(DOWN) then bg = bg % Backgrounds.count + 1; blip("cursor") end
            if stepped(LEFT) or stepped(UP) then bg = (bg - 2) % Backgrounds.count + 1; blip("cursor") end
            if pressed(A) then seed = seed + 1; Backgrounds.reset(bg, seed * 7919); blip("select") end
            if pressed(B) then go("hub", "Dissolve", "back") end
        end,
        update = function() Backgrounds.update(bg) end,
        draw = function()
            Backgrounds.draw(bg)
            gfx.setFont(fontTitle)
            outlined(Backgrounds.getName(bg), 10, 8)
            gfx.setFont(fontBold)
            outlined(bg .. " / " .. Backgrounds.count, 10, 28)
            outlined("left/right: background   A reseed   B back", 10, H - 16)
        end,
    }
end

-- ─── tween ─────────────────────────────────────────────────────────────────

do
    local names = Tween.easeNames
    local sel = 1
    local spring = Tween.newSpring(0, 3)
    local ball = { t = 0 }
    local anim = nil
    local wait = 0
    local follow = Tween.newSpring(200, 9)
    local target = 200

    -- Back and elastic easings overshoot 0..1: the plot fits the curve's own
    -- range, sampled once per easing, and marks where 0 and 1 are.
    local ranges = {}
    local function range(name)
        local r = ranges[name]
        if not r then
            local f, lo, hi = Tween.ease[name], 0, 1
            for i = 0, 90 do
                local v = f(i / 90)
                lo, hi = min(lo, v), max(hi, v)
            end
            r = { lo, hi }
            ranges[name] = r
        end
        return r[1], r[2]
    end

    -- A finished tween's node goes back to the pool, so the handle is only
    -- held while it runs: onComplete drops it.
    local function replay()
        if anim then anim:cancel() end
        ball.t = 0
        anim = Tween.field(ball, 40, "t", 1, names[sel]):onComplete(function() anim = nil end)
        wait = 70
    end

    scenes.tween = {
        enter = function() replay() end,
        leave = function() if anim then anim:cancel(); anim = nil end end,
        input = function()
            local s = navigate(sel, #names)
            if s ~= sel then sel = s; replay() end
            if pressed(A) then replay() end
            if pressed(B) then go("hub", "Slide", "back") end
            local cc = playdate.getCrankChange()
            target = max(210, min(385, target + cc * 0.6))
            if pressed(LEFT) then target = 215 end
            if pressed(RIGHT) then target = 380 end
        end,
        update = function()
            wait = wait - 1
            if wait <= 0 then replay() end
            follow:update(target)
        end,
        draw = function()
            gfx.clear(gfx.kColorWhite)
            header("Tween", #names .. " easings")
            list(names, sel, 10, 30, 150, 15, 12, spring)
            -- The curve, sampled; the ball rides it.
            local gx, gy, gw, gh = 205, 34, 180, 116
            gfx.setColor(gfx.kColorBlack)
            gfx.setDitherPattern(0.5, gfx.image.kDitherTypeBayer4x4)
            gfx.drawRect(gx, gy, gw, gh)
            local f = Tween.ease[names[sel]]
            local lo, hi = range(names[sel])
            local top, span = gy + 3, gh - 6
            local function plotY(v) return top + span - (v - lo) / (hi - lo) * span end
            if lo < 0 then gfx.drawLine(gx, plotY(0), gx + gw, plotY(0)) end
            if hi > 1 then gfx.drawLine(gx, plotY(1), gx + gw, plotY(1)) end
            gfx.setColor(gfx.kColorBlack)
            local px, py = gx, plotY(f(0))
            for i = 1, 60 do
                local t = i / 60
                local x, y = gx + t * gw, plotY(f(t))
                gfx.drawLine(px, py, x, y)
                px, py = x, y
            end
            local bx, by = gx + ball.t * gw, plotY(f(ball.t))
            gfx.fillCircleAtPoint(bx, by, 4)
            gfx.fillRect(gx - 12, by - 1, 6, 3)
            -- The spring chasing a target the crank moves: no fixed end to ease to.
            gfx.setFont(fontBold)
            gfx.drawText("Spring (crank, left/right)", 205, 160)
            gfx.drawLine(205, 196, 390, 196)
            gfx.drawLine(target, 190, target, 202)
            gfx.fillCircleAtPoint(floor(follow.value + 0.5), 196, 6)
            footer("up/down easing   A replay   B back")
        end,
    }
end

-- ─── shake & particles ─────────────────────────────────────────────────────

do
    local shaker = Shake.new("hit")
    local quake = Shake.new("quake")
    local ps = Particles.new(260, { seed = 7 })
    local crankSparks = 0
    Shake.load(); Particles.load()

    local function sound(chipName) Chiptune.sfx(chipName) end

    scenes.impact = {
        input = function()
            if pressed(A) then
                shaker:add(0.5)
                ps:emit(80 + math.random(240), 70 + math.random(90), "burst")
                sound("hit")
            end
            if pressed(UP) then
                quake:add(1.0)
                for _ = 1, 3 do ps:emit(120 + math.random(160), 150, "puff") end
                ps:emit(200, 190, "spark", 30)
                sound("explosion")
            end
            if pressed(DOWN) then
                ps:emit(200, 200, "spark")
                sound("shoot")
            end
            crankSparks = crankSparks + abs(playdate.getCrankChange()) / 40
            while crankSparks >= 1 do
                crankSparks = crankSparks - 1
                ps:emit(60 + (tick * 7) % 280, 200, "spark", 2)
            end
            if pressed(B) then go("hub", "Shatter", "back") end
        end,
        update = function()
            shaker:update(); quake:update(); ps:update()
        end,
        draw = function()
            gfx.clear(gfx.kColorWhite)
            Shake.apply(shaker); Shake.apply(quake)
            gfx.setColor(gfx.kColorBlack)
            gfx.fillRect(-20, 200, W + 40, 60)
            for i = 0, 5 do
                local x = 40 + i * 62
                gfx.setDitherPattern(0.25 * (i % 3 + 1), gfx.image.kDitherTypeBayer8x8)
                gfx.fillRect(x, 150 - (i % 3) * 20, 40, 50 + (i % 3) * 20)
                gfx.setColor(gfx.kColorBlack)
                gfx.drawRect(x, 150 - (i % 3) * 20, 40, 50 + (i % 3) * 20)
            end
            ps:draw()
            Shake.pop(); Shake.pop()
            header("Shake & Particles", "live " .. ps.count .. "  dropped " .. ps.dropped)
            gfx.setFont(fontBold)
            gfx.drawText("trauma", 10, 30)
            gfx.drawRect(60, 32, 100, 8)
            gfx.fillRect(60, 32, floor(100 * max(shaker.trauma, quake.trauma)), 8)
            footer("A hit   up quake   down sparks   crank: fountain   B back")
        end,
    }
end

-- ─── chiptune: music ───────────────────────────────────────────────────────

do
    local sel = 1
    local spring = Tween.newSpring(0, 3)
    local focus, chan = "songs", 1
    local muted = { false, false, false, false, false, false, false, false }
    local nch = 4
    local syncFlash, syncValue = 0, 0
    local held_ = false
    local pulse = Shake.new("bump")

    Chiptune.onSync(function(v) syncFlash, syncValue = 20, v; pulse:add(0.7) end)

    local function applyMute()
        local m = {}
        for c = 1, 8 do if muted[c] then m[#m + 1] = c end end
        Chiptune.mute(m)
    end

    scenes.music = {
        enter = function() focus = "songs" end,
        leave = function()
            muted = { false, false, false, false, false, false, false, false }; applyMute()
            Chiptune.hold(nil); held_ = false
        end,
        input = function()
            if focus == "songs" then
                sel = navigate(sel, #SONGS)
                if pressed(A) then Chiptune.play(SONGS[sel].id, { restart = true }) end
                if pressed(RIGHT) then focus = "mixer"; blip("cursor") end
            else
                if pressed(LEFT) and chan == 1 then
                    focus = "songs"; blip("cursor")
                elseif stepped(LEFT) and chan > 1 then
                    chan = chan - 1; blip("cursor")
                end
                if stepped(RIGHT) then chan = chan % nch + 1; blip("cursor") end
                if pressed(A) then muted[chan] = not muted[chan]; applyMute(); blip("toggle") end
                if pressed(UP) or pressed(DOWN) then
                    held_ = not held_
                    local order = Chiptune.position()
                    Chiptune.hold(held_ and order or nil)
                    blip("toggle")
                end
            end
            if pressed(B) then go("hub", "Scanline", "back") end
        end,
        update = function()
            pulse:update()
            if syncFlash > 0 then syncFlash = syncFlash - 1 end
        end,
        draw = function()
            gfx.clear(gfx.kColorWhite)
            header("Chiptune: Music", chipOk and "GB / SID / PCM" or "C extension not built")
            list(SONGS, sel, 10, 30, 180, 16, 9, spring, function(s) return s.title .. "  " .. s.tag end)
            gfx.setFont(fontBold)
            gfx.drawTextInRect(SONGS[sel].style, 10, 180, 185, 36)
            -- the mixer
            Shake.apply(pulse)
            local x0 = 215
            panel(x0 - 12, 28, 190, 158)
            local now = Chiptune.current()
            gfx.setFont(fontTitle)
            gfx.drawText(now and plain(now) or "(stopped)", x0, 38)
            local order, row = Chiptune.position()
            gfx.setFont(fontMono)
            gfx.drawText(string.format("order %02d  row %02d%s", order, row, held_ and "  HOLD" or ""), x0, 58)
            nch = meters(x0 + 4, 82, 64, focus == "mixer" and chan or nil, muted, 170)
            if chan > nch then chan = nch end
            if syncFlash > 0 then
                gfx.setFont(fontBold)
                gfx.fillRect(x0, 164, 160, 16)
                gfx.setImageDrawMode(gfx.kDrawModeFillWhite)
                gfx.drawText(string.format("sync E%02X", syncValue), x0 + 4, 165)
                gfx.setImageDrawMode(gfx.kDrawModeCopy)
            end
            Shake.pop()
            if focus == "songs" then
                footer("A play   right: mixer   B back")
            else
                footer("left/right channel   A mute   up/down hold order   B back")
            end
        end,
    }
end

-- ─── chiptune: sfx ─────────────────────────────────────────────────────────

do
    -- Row-major, three to a row, scrolling: the bank has 84 effects (a
    -- whoosh each way for every transition among them) and 13 rows show.
    local names = {}
    local sel = 1
    local COLS, VISIBLE = 3, 13
    local top = 0                 -- the first row on screen
    local spring = Tween.newSpring(0, 3)
    scenes.sfx = {
        enter = function()
            names = Chiptune.sfxNames()
            if not Chiptune.isPlaying() then Chiptune.play("crimson_clash") end
        end,
        input = function()
            local n = #names
            if n > 0 then
                local rows = (n - 1) // COLS + 1
                local row, col = (sel - 1) // COLS, (sel - 1) % COLS
                local moved = false
                if stepped(UP) then row = (row - 1) % rows; moved = true end
                if stepped(DOWN) then row = (row + 1) % rows; moved = true end
                if stepped(LEFT) then col = (col - 1) % COLS; moved = true end
                if stepped(RIGHT) then col = (col + 1) % COLS; moved = true end
                -- the crank scrolls a row per notch of about 30 degrees
                local ticks = playdate.getCrankTicks(12)
                if ticks ~= 0 then row = max(0, min(rows - 1, row + ticks)); moved = true end
                if moved then
                    sel = min(n, row * COLS + col + 1)
                    blip("cursor")
                end
                row = (sel - 1) // COLS
                if row < top then top = row end
                if row >= top + VISIBLE then top = row - VISIBLE + 1 end
                if pressed(A) then Chiptune.sfx(names[sel]) end
            end
            if pressed(B) then go("hub", "Pixel Shift", "back") end
        end,
        update = function() end,
        draw = function()
            gfx.clear(gfx.kColorWhite)
            header("Chiptune: SFX", #names .. " effects over the music")
            gfx.setFont(fontBold)
            if #names == 0 then
                gfx.drawText("Needs the C extension (python tools/build_demo.py).", 20, 60)
            end
            local n = #names
            local rows = (n - 1) // COLS + 1
            -- the list glides to its scroll position
            local y0 = 28 - floor(spring:update(top * 14) + 0.5)
            gfx.setClipRect(0, 24, 300, VISIBLE * 14 + 4)
            for i, name in ipairs(names) do
                local row, col = (i - 1) // COLS, (i - 1) % COLS
                local x, y = 6 + col * 98, y0 + row * 14
                if y > 10 and y < 24 + VISIBLE * 14 + 4 then
                    if i == sel then
                        gfx.fillRect(x - 2, y - 1, 96, 14)
                        gfx.setImageDrawMode(gfx.kDrawModeFillWhite)
                    end
                    gfx.drawText((plain(name):gsub("^tr ", "~")), x + 2, y)
                    gfx.setImageDrawMode(gfx.kDrawModeCopy)
                end
            end
            gfx.clearClipRect()
            -- the scroll bar
            if rows > VISIBLE then
                local h = VISIBLE * 14
                local bh = max(10, floor(h * VISIBLE / rows))
                local by = 28 + floor((h - bh) * top / (rows - VISIBLE))
                gfx.drawRect(300, 28, 4, h)
                gfx.fillRect(300, by, 4, bh)
            end
            meters(310, 34, 160, nil, nil, 88)
            footer("d-pad / crank pick   A fire (the music ducks)   B back")
        end,
    }
end

-- ─── jukebox ───────────────────────────────────────────────────────────────

do
    local sel, playing = 13, 13
    local mode = "live"
    local spring = Tween.newSpring(0, 3)
    local ok = true
    local function start()
        local id = SONGS[sel].id
        if mode == "live" then
            Jukebox.stop()
            ok = Chiptune.play(id, { restart = true })
        else
            Chiptune.stop()
            local prev = Jukebox.current()
            if prev and prev ~= id then
                Jukebox.switch(prev, id, 0.35, 0.35)
                ok = true
            else
                ok = Jukebox.play(id)
            end
        end
        playing = sel
    end
    scenes.jukebox = {
        enter = function()
            if not chipOk then mode = "stream" end
            start()
        end,
        leave = function() Jukebox.stop(); Chiptune.stop() end,
        input = function()
            sel = navigate(sel, #SONGS)
            if pressed(A) then start() end
            if pressed(LEFT) or pressed(RIGHT) then
                mode = mode == "live" and "stream" or "live"
                Jukebox.stop(); Chiptune.stop(); start()
            end
            if pressed(B) then go("hub", "Fade", "back") end
        end,
        update = function() end,
        draw = function()
            gfx.clear(gfx.kColorWhite)
            header("Jukebox", mode == "live" and "LIVE TRACKER" or SONGS[playing].reference and "STUDIO REFERENCE" or "ADPCM STREAM")
            list(SONGS, sel, 10, 30, 192, 16, 10, spring, function(s) return s.title .. "  " .. s.tag end)
            gfx.setFont(fontBold)
            gfx.drawTextInRect(SONGS[sel].style, 10, 194, 192, 28)
            panel(211, 30, 179, 171)
            gfx.setFont(fontTitle)
            gfx.drawText("Now playing", 222, 42)
            gfx.setFont(fontBold)
            gfx.drawTextInRect(SONGS[playing].title, 222, 65, 158, 28)
            if not ok then
                gfx.drawTextInRect("Track unavailable. Try the other playback mode.", 222, 100, 154, 80)
            elseif mode == "live" then
                local order, row = Chiptune.position()
                gfx.setFont(fontMono)
                gfx.drawText(string.format("order %02d row %02d", order, row), 222, 96)
                meters(222, 119, 54, nil, nil, 156)
            else
                gfx.drawTextInRect(SONGS[playing].reference and "The original studio master, for listening A/B." or
                    "The same arrangement, streamed from a rendered audio loop.", 222, 105, 154, 80)
            end
            footer("up/down track   A play   left/right live/stream   B back")
        end,
    }
end

-- ─── credits ───────────────────────────────────────────────────────────────

do
    -- The roll is the module; everything around it is the rest of the zoo,
    -- wired in through cues: typing clicks from the SFX bank, a spark burst
    -- as the paw lands mid-screen, a jolt and a jingle on THE END.
    local stars = Backgrounds.indexOf("Starfield") or 1
    local jolt = Shake.new("hit")
    local sparks = Particles.new(120, { seed = 11, color = "white" })
    local roll

    local function build()
        roll = Credits.new({
            { title = "JUICE ZOO", sub = "every module of playdate-juice" },
            { heading = "Modules" },
            { role = "Transitions", name = "23 wipes" },
            { role = "Chiptune", names = { "Game Boy", "SID voices", "studio PCM" } },
            { role = "Jukebox", name = "streamed music" },
            { role = "Tween", name = "31 easings" },
            { role = "Shake", name = "trauma" },
            { role = "Particles", name = "pooled, 1-bit" },
            { role = "Backgrounds", name = "17 loops" },
            { role = "Credits", name = "this roll" },
            { heading = "Borrowed from" },
            { names = { "Nyandoku", "gameboy-lab", "playdate-transitions" } },
            { rule = true },
            { image = "images/paw_print", ink = true, hold = 40,
              on = function(_, _, x, y) sparks:emit(x, y, "burst", 20); blip("magic") end },
            { text = "Crank to scrub. Hold A to fast-forward. B skips to the end." },
            { card = "THE END", hold = 60, on = function() jolt:add(0.6); blip("win") end },
            { card = { { heading = "Thanks for visiting" }, { name = "B: back to the hub" } } },
        }, {
            invert = true,
            fit = 30 * 40,
            background = function() Backgrounds.draw(stars) end,
            onType = function() blip("text") end,
        })
    end

    scenes.credits = {
        enter = function()
            if not roll then build() end
            roll:restart()
            sparks:clear()
            Chiptune.play("willow_lane")
        end,
        input = function()
            -- the roll reads the crank, A and B itself; B only leaves once
            -- it has nothing left to skip
            if roll.done and pressed(B) then go("hub", "Blink", "back") end
        end,
        update = function()
            Backgrounds.update(stars)
            roll:update()
            jolt:update()
            sparks:update()
        end,
        draw = function()
            Shake.apply(jolt)
            roll:draw()
            sparks:draw()
            Shake.pop()
        end,
    }
end

-- ─── the loop ──────────────────────────────────────────────────────────────

scenes[current].enter()

function playdate.update()
    trackHeld()
    Tween.update()
    Chiptune.update()
    tick = tick + 1
    local s = scenes[current]
    if not Transitions.active then s.input() end
    s.update()
    Transitions.draw(function() scenes[current].draw() end)
end
